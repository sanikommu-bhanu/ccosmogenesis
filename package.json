{
  "name": "story-of-universe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "textures": "node scripts/fetch-textures.mjs",
    "textures:force": "node scripts/fetch-textures.mjs --force",
    "verify": "node scripts/verify-timeline.mjs && node scripts/verify-textures.mjs",
    "verify:timeline": "node scripts/verify-timeline.mjs",
    "verify:textures": "node scripts/verify-textures.mjs",
    "postinstall": "node scripts/fetch-textures.mjs || echo \"  textures incomplete - run 'npm run textures' to retry\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "framer-motion": "^13.1.0",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lenis": "^1.3.26",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
